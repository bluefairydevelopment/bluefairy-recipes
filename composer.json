{
    "name": "bluefairy/recipes",
    "description": "Recipes for WordPress: ingredients, steps, nutrition, writers, browse taxonomies, a filterable archive and Recipe JSON-LD. Free base plugin; BlueFairy Recipes Pro adds reviews, submissions and WooCommerce.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "version": "1.0.0",
    "keywords": ["wordpress", "recipes", "recipe-schema", "food-blog"],
    "authors": [
        {
            "name": "Blue Fairy Development",
            "homepage": "https://bluefairydevelopment.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.0",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcsstandards/phpcsutils": "^1.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "BlueFairy\\Recipes\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BlueFairy\\Recipes\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "coverage": "php bin/method-coverage.php"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
