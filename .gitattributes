# What ships: the plugin zip is built by `git archive` (wp-deploy/wp-release.sh), which
# honours export-ignore and nothing else. Mirrors .distignore entry for entry (a unit test keeps them equal).
/.git export-ignore
/.github export-ignore
/.gitignore export-ignore
/.distignore export-ignore
/.gitattributes export-ignore
/.cache export-ignore
/.phpunit.cache export-ignore
/.phpunit.result.cache export-ignore
/node_modules export-ignore
/vendor export-ignore
/tests export-ignore
/bin export-ignore
# docs/: everything but the features guide PDF (a later rule unsets the earlier one).
/docs/** export-ignore
/docs/*FeaturesGuide.pdf -export-ignore
/FEATURES.md export-ignore
/README.md export-ignore
/coverage export-ignore
/composer.json export-ignore
/composer.lock export-ignore
/phpcs.xml.dist export-ignore
/phpstan.neon export-ignore
/phpstan-bootstrap.php export-ignore
/phpunit.xml.dist export-ignore
/.DS_Store export-ignore
/SECURITY.md export-ignore
